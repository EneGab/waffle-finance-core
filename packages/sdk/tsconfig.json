{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // #731: colocated *.test.ts files were inside `include`, so
  // dist/shared-utils/rpc-compat.test.js shipped in the published tarball —
  // compiled vitest and all. They are still typechecked, by
  // tsconfig.typecheck.json.
  "exclude": ["src/**/*.test.ts", "node_modules", "dist", ".sdk-cost-tmp"]
}
